heat_map_common_sites <- function(df) {
df <- df %>%  filter(Mean_Enrichment_IC50 > enrichment_cutoff | Mean_Enrichment_IC90 > enrichment_cutoff | Mean_Enrichment_IC99 > enrichment_cutoff)
df  <-  select(df, position,hgvs,Mean_Enrichment_IC50, Mean_Enrichment_IC90, Mean_Enrichment_IC99)
#Maybe use a combinatino of both, have two heatmaps ...
#df <- df %>% mutate(Enrichment_Total = Mean_Enrichment_IC50 + Mean_Enrichment_IC90 +Mean_Enrichment_IC99)
#df <- df %>% arrange(desc(Mean_Enrichment_IC99)) %>% head(20)
#df$hgvs <- factor(df$hgvs, levels = rev(df$hgvs[order(df$position)]))
df <- df %>%pivot_longer(cols = c(Mean_Enrichment_IC50, Mean_Enrichment_IC90, Mean_Enrichment_IC99),
names_to = "measurement",
values_to = "enrichment")
# 2) Top N per measurement (IC50 / IC90 / IC99)
top_per_measurement <- df %>%
group_by(measurement) %>%
slice_max(enrichment, n = 10) %>%ungroup()
# 3) Restrict long data to the union of those top variants
df <- df %>%
semi_join(top_per_measurement,
by = c("position", "hgvs", "measurement", "enrichment")
)
return(df)
heatmap_common <- ggplot(df, aes(x = measurement, y = hgvs, fill = enrichment)) + geom_tile() +coord_fixed()+
theme_minimal(base_size = 12) +theme(axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 6))+ scale_fill_gradient(low = "white",high = "#56B1F7")+
geom_text(data =filter(df, enrichment > enrichment_cutoff),label = "*",size = 3,  color = "black")
return(heatmap_common)
}
