#BrefA
heat_map_common_sites(df_BrefA_full, drug_name = "BrefA")
#Creating a function to plot top 10 hits of IC50/90/99 in a heatmap
heat_map_common_sites <- function(df,drug_name) {
#Filter for any site that is higher than cutoff for IC50, 90, 99
df <- df %>%  filter(Mean_Enrichment_IC50 > enrichment_cutoff | Mean_Enrichment_IC90 > enrichment_cutoff | Mean_Enrichment_IC99 > enrichment_cutoff)
#Select columns of interest
df  <-  select(df, position,hgvs,Mean_Enrichment_IC50, Mean_Enrichment_IC90, Mean_Enrichment_IC99)
#Use factor to order hgvs according to position
df$hgvs <- factor(df$hgvs, levels = rev(df$hgvs[order(df$position)]))
#Create a df with top 10 from each IC
df_50 <- df %>% arrange(desc(Mean_Enrichment_IC50)) %>% head(10)
df_90 <- df %>% arrange(desc(Mean_Enrichment_IC90)) %>% head(10)
df_99 <- df %>% arrange(desc(Mean_Enrichment_IC99)) %>% head(10)
#Binds the row of dataframe IC50/IC90/IC99 : then keep only distinct positions and hgvs
df <- bind_rows(df_50, df_90, df_99) %>% distinct(hgvs, .keep_all = TRUE)
df <- df %>% pivot_longer(cols = c(Mean_Enrichment_IC50, Mean_Enrichment_IC90, Mean_Enrichment_IC99),
names_to = "measurement",
values_to = "enrichment")
heatmap_common <- ggplot(df, aes(x = measurement, y = hgvs, fill = enrichment)) + geom_tile() +coord_fixed()+
theme_minimal(base_size = 12) +theme(axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 6))+ scale_fill_gradient(low = "white",high = "#56B1F7")+
geom_tile(
data = filter(df, enrichment > enrichment_cutoff),fill = NA,color = "red",linewidth = 0.2)
ggsave(plot = heatmap_common, filename = paste0("Heatmap_top", drug_name, ".pdf"), height = 6, width = 4)
return(heatmap_common)
}
#Usage of function:
#Rupi
heat_map_common_sites(df_rupi_full, drug_name = "rupi")
#Guan
heat_map_common_sites(df_guan_full, drug_name = "guan")
#Envi
heat_map_common_sites(df_enviroxime_full, drug_name = "envi")
#BrefA
heat_map_common_sites(df_BrefA_full, drug_name = "BrefA")
