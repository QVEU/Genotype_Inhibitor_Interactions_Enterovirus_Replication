heat_map_common_sites <- function(df,drug_name) {
#Filter for any site that is higher than cutoff for IC50, 90, 99
df <- df %>%  filter(Mean_Enrichment_IC50 > enrichment_cutoff | Mean_Enrichment_IC90 > enrichment_cutoff | Mean_Enrichment_IC99 > enrichment_cutoff)
df$ref_aa <- gsub("p\\.\\(([A-Z])\\d+[A-Z]\\)", "\\1", df$hgvs)
df$alt_aa <- gsub("p\\.\\([A-Z]\\d+([A-Z])\\)", "\\1", df$hgvs)
df$hgvs <- paste0("p.(",df$ref_aa,df$position,df$alt_aa,")")
#Select columns of interest
df  <-  select(df, position,hgvs,Mean_Enrichment_IC50, Mean_Enrichment_IC90, Mean_Enrichment_IC99)
#Use factor to order hgvs according to position
df$hgvs <- factor(df$hgvs, levels = rev(df$hgvs[order(df$position)]))
#Create a df with top 10 from each IC
df_50 <- df %>% arrange(desc(Mean_Enrichment_IC50)) %>% head(10)
df_90 <- df %>% arrange(desc(Mean_Enrichment_IC90)) %>% head(10)
df_99 <- df %>% arrange(desc(Mean_Enrichment_IC99)) %>% head(10)
