library(tidyverse)
library(scales)
library(cowplot)
library(growthcurver)
Replicon_Analysis_Resistance <- function(input_dataframe,sample_mapping,xmin,xmax,ylims)
{
#Reading in .csv file from Neo2 replicon dataset
Replicon_dataframe <- read_csv(input_dataframe)
#Changing Time to character
Replicon_dataframe$Time <- as.character(Replicon_dataframe$Time)
#Changing time format into minutes
Replicon_dataframe$Time <- as.numeric(as.difftime(Replicon_dataframe$Time, format = "%H:%M:%S", units = "mins"))
#Changing column names to the corresponding sample names using rename with splice operator
Replicon_dataframe <- rename(Replicon_dataframe,!!!sample_mapping)
#Pivot longer the dataset
Replicon_dataframe <- pivot_longer(Replicon_dataframe, cols = -Time, names_to = "SampleName",values_to = "RLU")
#Subset dataframe so that it only has samples that start with Conc
Replicon_dataframe <- subset(Replicon_dataframe, grepl("^Conc", SampleName))
#Extract the concentration from the string
Replicon_dataframe <- Replicon_dataframe %>% mutate(concentration = as.numeric(gsub("Conc_(\\d+).*", "\\1", SampleName)))
#Group by time and concentration and calculate the mean and sd at each timepoint
Replicon_dataframe <- Replicon_dataframe %>% group_by(Time, concentration) %>%
mutate(mean_RLU = mean(RLU),sd_RLU = sd(RLU)) %>% distinct(Time, concentration, .keep_all = TRUE)
#Select columns of interest
Replicon_dataframe <- select(Replicon_dataframe,Time,concentration,mean_RLU,sd_RLU)
#Transform Concentration to factor
Replicon_dataframe$concentration <- as.factor(Replicon_dataframe$concentration)
# Create the main plot with the replicon data
Plot <- ggplot(Replicon_dataframe, aes(x = Time, y = mean_RLU,color=concentration)) +
geom_point(size=0.1) +labs(x = "Time (min)", y = "RLU") +theme_bw() +theme(legend.position = "none")+
scale_color_manual(values = c("0"  = "black","90" = "orange","99" = "red" ))+xlim(xmin,xmax)+
geom_errorbar(aes(ymin = mean_RLU - sd_RLU,ymax = mean_RLU + sd_RLU))+
scale_y_continuous(labels = label_scientific(),limits=ylims)
return(list(replication_concentrationdataframe=Replicon_dataframe,plot=Plot))
}
